@if(TempData["Success"] is string message){<div class="toast-container position-fixed top-0 end-0 p-3"><div class="toast text-bg-success" role="status"><div class="toast-body">@message</div></div></div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
