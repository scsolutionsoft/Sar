<form asp-action="Upload" method="post" enctype="multipart/form-data" class="panel upload-zone"><input type="hidden" name="id" value="@Model.Id"/><div class="section-title"><span class="section-icon"><partial name="_Icon" model='"folder"'/></span><div><h2 class="mb-0">เพิ่มภาพและเอกสาร</h2><small>เลือกรูปภาพหรือ PDF เพื่อดูตัวอย่างก่อนอัปโหลด</small></div></div>@if(ViewBag.CertificateStudents != null){<label for="certificateStudentId" class="form-label mt-3">ผู้รับเกียรติบัตรสำหรับไฟล์ชุดนี้</label><select id="certificateStudentId" name="studentId" class="form-select"><option value="">เอกสารส่วนกลาง — ไม่แสดงในบัญชีนักเรียน</option>@foreach(Student student in ViewBag.CertificateStudents){<option value="@student.Id">@student.Name · @student.Code</option>}</select><small class="text-muted">เลือกนักเรียนเจ้าของเกียรติบัตรก่อนอัปโหลด นักเรียนจะเห็นเฉพาะไฟล์ที่ระบุชื่อตนเมื่อรางวัลเผยแพร่แล้ว</small>}<label for="uploadFiles" class="form-label">สูงสุด 10 MB ต่อไฟล์ รวมไม่เกิน 50 MB</label><input type="file" id="uploadFiles" name="files" class="form-control" multiple required accept=".jpg,.jpeg,.png,.webp,.pdf,.docx,.xlsx"/><button class="btn btn-primary mt-3">อัปโหลด</button></form>
