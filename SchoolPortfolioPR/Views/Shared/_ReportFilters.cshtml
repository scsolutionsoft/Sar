@model ReportFilter
@if(User.IsInRole("Student") && !Roles.Editors.Any(User.IsInRole)){<p class="alert alert-info">รายงานของนักเรียนแสดงเฉพาะข้อมูลที่เผยแพร่และมีชื่อคุณเข้าร่วม เอกสารและแฟ้มที่สร้างเองอยู่ในคลัง PDF ส่วนตัวและแฟ้มยื่นเรียนต่อ</p>}
<div class="row"><div class="col-md-4"><label class="form-label" asp-for="From">ตั้งแต่วันที่ (ค.ศ.)</label><input asp-for="From" type="date" class="form-control"/></div><div class="col-md-4"><label class="form-label" asp-for="To">ถึงวันที่ (ค.ศ.)</label><input asp-for="To" type="date" class="form-control"/></div><div class="col-md-4"><label class="form-label" asp-for="AcademicYearId">ปีการศึกษา</label><select asp-for="AcademicYearId" asp-items="ViewBag.AcademicYears" class="form-select"><option value="">ทั้งหมด</option></select></div>
<div class="col-md-4"><label class="form-label" asp-for="DepartmentId">ฝ่าย</label><select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select"><option value="">ทั้งหมด</option></select></div><div class="col-md-4"><label class="form-label" asp-for="SubjectGroupId">กลุ่มสาระ</label><select asp-for="SubjectGroupId" asp-items="ViewBag.SubjectGroups" class="form-select"><option value="">ทั้งหมด</option></select></div><div class="col-md-4"><label class="form-label" asp-for="CategoryId">ประเภทกิจกรรม</label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">ทั้งหมด</option></select></div>
<div class="col-md-4"><label class="form-label" asp-for="TeacherId">ครู</label><select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-select"><option value="">ทั้งหมด</option></select></div><div class="col-md-4"><label class="form-label" asp-for="StudentId">นักเรียน</label><select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select"><option value="">ทั้งหมด</option></select></div><div class="col-md-4"><label class="form-label" asp-for="AwardLevel">ระดับรางวัล</label><select asp-for="AwardLevel" asp-items="Html.GetEnumSelectList<AwardLevel>()" class="form-select"><option value="">ทั้งหมด</option></select></div>
<div class="col-md-4"><label class="form-label" asp-for="FiscalYear">ปีงบประมาณ (พ.ศ.)</label><input asp-for="FiscalYear" class="form-control" min="2400" max="3000"/></div><div class="col-md-4"><label class="form-label" asp-for="Month">เดือน</label><input asp-for="Month" class="form-control" min="1" max="12"/></div></div>
