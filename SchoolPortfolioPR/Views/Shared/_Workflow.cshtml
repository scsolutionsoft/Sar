<div class="d-flex flex-wrap gap-2 my-3">@foreach(WorkflowStatus status in ViewBag.Transitions){<form asp-action="Transition" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><input type="hidden" name="status" value="@status"/><button class="btn btn-outline-primary">@Thai.Status(status)</button></form>}</div>
