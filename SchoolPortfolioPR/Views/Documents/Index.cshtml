@model PageView<PersonalDocument>
@{ViewData["Title"]="คลัง PDF ส่วนตัว";ViewBag.Page=Model.Page;ViewBag.Pages=Model.Pages;}
<div class="page-head"><div><p class="eyebrow">MY DOCUMENT LIBRARY</p><h1>คลัง PDF ส่วนตัว</h1><p class="muted">จัดเก็บรายงาน ผลการเรียน และหลักฐานผลงานในพื้นที่ของคุณ</p></div><a class="btn btn-primary" asp-action="Edit">+ เพิ่ม PDF / สร้างรายงาน</a></div>
<form method="get" class="panel d-flex flex-wrap gap-3"><input name="q" value="@ViewBag.Search" class="form-control w-auto" placeholder="ค้นหาเอกสาร" aria-label="ค้นหาเอกสาร"/><select name="category" class="form-select w-auto" aria-label="หมวดหมู่"><option value="">ทุกหมวดหมู่</option>@foreach(string c in ViewBag.Categories){<option value="@c" selected="@(c==(string?)ViewBag.Category)">@c</option>}</select><button class="btn btn-outline-primary">ค้นหา</button><span class="muted align-self-center">@Model.Total เอกสาร</span></form>
<div class="personal-doc-grid">@foreach(var d in Model.Items){<article class="panel personal-doc" data-document-id="@d.Id"><span class="pdf-stamp">PDF</span><small>@d.Category · @d.Pages หน้า</small><h2>@d.Title</h2><p class="muted">@d.Description</p><small>@Thai.Date(d.DocumentDate)</small><div class="d-flex gap-2 mt-3 flex-wrap"><a class="btn btn-sm btn-primary" href="/files/@d.FileId" data-media-preview data-media-type="pdf" data-media-title="@d.Title">เปิด PDF</a><a class="btn btn-sm btn-light" href="/files/@d.FileId?download=true">ดาวน์โหลด</a><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@d.Id">แก้ไข</a><form method="post" asp-action="Delete" data-confirm><input type="hidden" name="id" value="@d.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(d.RowVersion)"/><button class="btn btn-sm btn-outline-danger">ลบ</button></form></div></article>}</div>
@if(Model.Total==0){<div class="panel empty">ยังไม่มีเอกสาร เพิ่ม PDF หรือเขียนรายงานแล้วสร้างเป็น PDF ได้เลย</div>}<partial name="_Pagination"/>
@if(ViewBag.IsStudent == true){<h2>แฟ้มสะสมผลงานที่ส่งออกแล้ว</h2><div class="personal-doc-grid">@foreach(AdmissionPortfolio p in ViewBag.Portfolios){<article class="panel"><p class="eyebrow">PORTFOLIO PDF · @p.ExportedPages หน้า</p><h3>@p.Title</h3><a asp-controller="Admissions" asp-action="Viewer" asp-route-id="@p.Id">เปิดอ่านแบบพลิกหน้า →</a></article>}</div>}
