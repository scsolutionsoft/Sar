@model DocumentForm
@{ViewData["Title"]=Model.Id==0?"เพิ่มเอกสารส่วนตัว":"แก้ไขข้อมูลเอกสาร";}
<div class="page-head"><div><p class="eyebrow">PERSONAL PDF</p><h1>@ViewData["Title"]</h1></div><a class="btn btn-light" asp-action="Index">กลับคลังเอกสาร</a></div>
<form method="post" enctype="multipart/form-data" class="panel"><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label asp-for="Title"></label><input asp-for="Title" class="form-control" required maxlength="200"/></div><div class="col-md-4"><label asp-for="Category"></label><input asp-for="Category" class="form-control" list="docCategories" required/><datalist id="docCategories"><option>รายงาน</option><option>ผลการเรียน</option><option>เกียรติบัตร</option><option>หนังสือรับรอง</option><option>โครงงาน</option></datalist></div><div class="col-md-4"><label asp-for="DocumentDate"></label><input asp-for="DocumentDate" class="form-control" type="date"/></div><div class="col-12"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
@if(Model.Id==0){<div class="col-md-6"><h2>อัปโหลด PDF</h2><input asp-for="Upload" type="file" accept="application/pdf" class="form-control"/><small class="muted">ไม่เกิน 10 MB · ไม่ติดรหัสผ่าน · ไม่เกิน 100 หน้า</small></div><div class="col-md-6"><h2>หรือสร้างรายงานใหม่</h2><label asp-for="ReportText"></label><textarea asp-for="ReportText" class="form-control" rows="8" placeholder="พิมพ์เนื้อหา ระบบจะสร้าง PDF ให้"></textarea></div>}
</div><button class="btn btn-primary mt-4">บันทึกเอกสาร</button></form>
