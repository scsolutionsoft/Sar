@model PublicationForm
@{ViewData["Title"] = "จัดทำวารสาร";}
<h1>จัดทำวารสารรายเดือน</h1>@if(Model.Id == 0){<form method="get" class="panel d-flex gap-2"><label>ปี ค.ศ. <input name="year" type="number" value="@Model.Year" min="2000" max="2400" class="form-control"/></label><label>เดือน <input name="month" type="number" value="@Model.Month" min="1" max="12" class="form-control"/></label><button class="btn btn-outline-primary align-self-end">ดึงรายการเดือนนี้</button></form>}
<form method="post" class="panel"><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><input asp-for="Year" type="hidden"/><input asp-for="Month" type="hidden"/><div asp-validation-summary="All"></div><p>ฉบับเดือน @Model.Month / @(Model.Year + 543)</p><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"/><label asp-for="DirectorMessage" class="form-label"></label><textarea asp-for="DirectorMessage" class="form-control" rows="6"></textarea><h2 class="mt-4">เลือกรายการและจัดลำดับ</h2><p>แสดงเฉพาะกิจกรรมและรางวัลที่เผยแพร่สาธารณะของเดือนนี้ ลากเพื่อจัดลำดับภายในหมวด</p><div data-sortable>@foreach(PublicationChoice c in ViewBag.Choices){<div class="drag-item"><label><input type="checkbox" name="SelectedItems" value="@c.Key" checked="@c.Selected"/> @c.Title <small>· @c.Section</small></label><button type="button" class="btn btn-sm btn-light" data-up>↑</button><button type="button" class="btn btn-sm btn-light" data-down>↓</button></div>}</div><button class="btn btn-primary mt-3">บันทึกวารสาร</button></form>
