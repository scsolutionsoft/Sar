@model List<MonthlyPublication>
@{ViewData["Title"] = "วารสารโรงเรียน"; var pdfFiles = (Dictionary<int,Guid>)ViewBag.PdfFiles; bool editor = User.IsInRole("SuperAdmin") || User.IsInRole("Administrator") || User.IsInRole("PRAdmin");}
<div class="page-head"><div><p class="eyebrow">Monthly publications</p><h1>วารสารโรงเรียน</h1></div>@if(editor){<a class="btn btn-primary" asp-action="Edit">+ สร้างวารสาร</a>}</div><div class="row">@foreach(var p in Model){<div class="col-md-6 col-xl-4"><div class="panel"><div class="cover-placeholder mb-3">@(p.Month.ToString("00")) / @(p.Year + 543)</div><h2>@p.Title</h2><p>@(p.IsPublic ? "เผยแพร่แล้ว" : "ฉบับร่าง")</p><a asp-action="Viewer" asp-route-year="@(p.Year + 543)" asp-route-month="@p.Month" class="btn btn-primary">อ่านวารสาร</a>@if(pdfFiles.TryGetValue(p.Id, out var pdfId)){<a class="btn btn-outline-primary" href="/files/@pdfId" data-media-preview data-media-type="pdf" data-media-title="@(p.Title + ".pdf")">ดู PDF</a>}@if(editor){<a asp-action="Manage" asp-route-id="@p.Id" class="btn btn-light">จัดการ</a>}</div></div>}</div>@if(Model.Count == 0){<div class="panel empty">ยังไม่มีวารสาร</div>}

