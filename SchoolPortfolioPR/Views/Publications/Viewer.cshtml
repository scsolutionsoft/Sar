@model MonthlyPublication
@{ViewData["Title"] = Model.Title; Guid? pdf = ViewBag.PdfId;}
<h1>@Model.Title</h1>@if(pdf == null){<div class="panel empty">ยังไม่ได้สร้าง PDF</div>}else{<div id="flipbook" data-pdf="/files/@pdf" class="panel"><div class="viewer-toolbar"><button id="previous" class="btn btn-light">← ก่อนหน้า</button><button id="next" class="btn btn-light">ถัดไป →</button><label>หน้า <input id="pageNumber" type="number" min="1" value="1" class="form-control d-inline"/> / <span id="pageCount">…</span></label><button id="zoomOut" class="btn btn-light" aria-label="ย่อ">−</button><button id="zoomIn" class="btn btn-light" aria-label="ขยาย">+</button><button id="fullscreen" class="btn btn-light">เต็มจอ</button><a class="btn btn-outline-primary" href="/files/@pdf" data-media-preview data-media-type="pdf" data-media-title="@(Model.Title + ".pdf")">ดู PDF</a><a class="btn btn-light" href="/files/@pdf?download=true">ดาวน์โหลด PDF</a><button id="share" class="btn btn-light">แชร์</button></div><div class="row"><div class="col-md-3"><h2>สารบัญ</h2><select id="toc" class="form-select" size="12" aria-label="สารบัญ"></select>@if(Model.IsPublic){<a class="media-trigger mt-3" href="/Publications/Qr/@Model.Id" data-media-preview data-media-type="image" data-media-title="QR Code วารสาร"><img src="/Publications/Qr/@Model.Id" alt="QR Code วารสาร" width="150" height="150"/></a>}</div><div class="col-md-9"><div class="flip-stage"><canvas id="pdfCanvas" aria-label="หน้าวารสาร"></canvas></div></div></div><p id="viewerStatus" role="status"></p></div>}
@section Scripts {<script type="module" src="~/js/flipbook.js" asp-append-version="true"></script>}

