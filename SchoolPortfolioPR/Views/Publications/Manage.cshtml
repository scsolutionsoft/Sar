@model MonthlyPublication
@{ViewData["Title"] = Model.Title;}
<h1>@Model.Title</h1><div class="panel"><p>เดือน @Model.Month / @(Model.Year + 543)</p><a class="btn btn-light" asp-action="Edit" asp-route-id="@Model.Id">แก้ไขเนื้อหาและลำดับ</a><form asp-action="Generate" method="post" class="mt-4"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><label><input type="checkbox" name="publish" value="true" checked="@Model.IsPublic"/> เผยแพร่สาธารณะหลังสร้าง PDF</label><p class="muted">PDF จะรวมปก สารผู้อำนวยการ สารบัญ ข่าว กิจกรรม ผลงาน รางวัล ภาพ และสถิติ</p><button class="btn btn-primary">สร้าง PDF และบันทึกการเผยแพร่</button></form></div><form asp-action="Delete" method="post" data-confirm><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-danger">ลบวารสาร</button></form>
