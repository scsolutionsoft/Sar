@model AnnouncementForm
@{ ViewData["Title"] = Model.Id == 0 ? "เพิ่มข่าวประชาสัมพันธ์" : "แก้ไขข่าวประชาสัมพันธ์"; var images = (List<AnnouncementImageChoice>)ViewBag.Images; }
<div class="page-head"><div><p class="eyebrow">DESIGN YOUR ANNOUNCEMENT</p><h1>@ViewData["Title"]</h1><p class="muted">จัดองค์ประกอบข่าวให้เหมาะกับเรื่องราว แล้วกำหนดวันแสดงบนหน้าแรก</p></div><a class="btn btn-light" asp-action="Index">กลับกระดานข่าว</a></div>
<form method="post" enctype="multipart/form-data" id="announcementForm">
<input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-4"><div class="col-xl-8">
<section class="panel"><h2>เนื้อหาข่าว</h2><div class="mb-3"><label asp-for="Title"></label><input asp-for="Title" class="form-control" maxlength="250" required/></div><div class="mb-3"><label asp-for="Category"></label><input asp-for="Category" class="form-control" maxlength="80" required list="announcementCategories"/><datalist id="announcementCategories"><option>ข่าวประชาสัมพันธ์</option><option>รับสมัคร</option><option>กิจกรรมนักเรียน</option><option>วิชาการ</option><option>สิ่งแวดล้อม</option><option>ประกาศสำคัญ</option></datalist></div><div class="mb-3"><label asp-for="Summary"></label><textarea asp-for="Summary" class="form-control" rows="3" maxlength="500" required></textarea></div><div><label asp-for="Body"></label><textarea asp-for="Body" class="form-control" rows="7" maxlength="30000"></textarea></div></section>
<section class="panel"><h2>เลือกภาพประกอบ</h2><p class="muted">ใช้ภาพจากกิจกรรม หรืออัปโหลดภาพใหม่ ภาพที่เลือกจะเป็นสำเนาของข่าวนี้และแสดงสาธารณะตามช่วงวันที่</p>
@if(Model.CurrentImageId.HasValue){<div class="pr-current-image"><a href="/files/@Model.CurrentImageId" data-media-preview data-media-type="image" data-media-title="ภาพปัจจุบัน"><img src="/files/@Model.CurrentImageId" alt="ภาพปัจจุบัน"/></a><label><input asp-for="RemoveImage"/> ลบภาพเดิม</label></div>}
<div class="mb-4"><label asp-for="Upload"></label><input asp-for="Upload" class="form-control" type="file" accept="image/jpeg,image/png,image/webp"/><small class="muted">JPG, PNG, WebP ไม่เกิน 10 MB</small></div>
<details><summary>เลือกภาพจากคลังกิจกรรม (@images.Count ภาพ)</summary><label class="d-block my-3"><input type="radio" name="SourceImageId" value="" checked="@(!Model.SourceImageId.HasValue)"/> ไม่เลือกภาพจากคลัง / ใช้ภาพเดิม</label><div class="pr-image-picker">@foreach(var image in images){<label class="pr-image-option"><input type="radio" name="SourceImageId" value="@image.Id" checked="@(Model.SourceImageId == image.Id)"/><img src="/files/@image.Id" alt="@image.Name" loading="lazy"/><span>@image.ActivityTitle</span></label>}</div></details></section>
</div><div class="col-xl-4"><section class="panel"><h2>รูปแบบกรอบ</h2><fieldset class="mb-4"><legend class="fs-6">ขนาดที่แสดงบนหน้าแรก</legend><div class="pr-size-options">@foreach(var size in Enum.GetValues<AnnouncementSize>()){<label><input asp-for="Size" type="radio" value="@size"/><span class="pr-size-symbol pr-symbol-@size.ToString().ToLowerInvariant()"></span><strong>@(size == AnnouncementSize.Large ? "ใหญ่" : size == AnnouncementSize.Medium ? "กลาง" : "เล็ก")</strong></label>}</div><small class="muted">มือถือจะเรียงเป็นหนึ่งคอลัมน์เพื่อให้อ่านง่าย</small></fieldset><div class="mb-3"><label asp-for="Tone"></label><select asp-for="Tone" asp-items="Html.GetEnumSelectList<AnnouncementTone>()" class="form-select"></select></div><div><label asp-for="SortOrder"></label><input asp-for="SortOrder" type="number" min="0" max="9999" class="form-control"/></div></section>
<section class="panel"><h2>กำหนดช่วงเวลา</h2><div class="mb-3"><label asp-for="StartDate"></label><input asp-for="StartDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" required/></div><div class="mb-3"><label asp-for="EndDate"></label><input asp-for="EndDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" required/></div><p class="muted">แสดงจนสิ้นวันสุดท้ายตามเวลาไทย แล้วซ่อนโดยอัตโนมัติ</p><label class="form-check"><input asp-for="IsEnabled" class="form-check-input"/><span asp-for="IsEnabled" class="form-check-label">เปิดแสดงบนหน้าแรกตามกำหนดเวลา</span></label></section>
<section class="panel"><h2>ตัวอย่างกรอบข่าว</h2><div id="announcementPreview" class="pr-tile pr-preview pr-tone-@Model.Tone.ToString().ToLowerInvariant()" data-current-image="@(Model.CurrentImageId.HasValue ? "/files/" + Model.CurrentImageId : "")"><img class="pr-tile-image" alt="ภาพตัวอย่างกรอบข่าว" hidden/><div class="pr-tile-shade"></div><div class="pr-tile-top"><span class="pr-category" data-preview-category></span></div><div class="pr-tile-content"><small data-preview-date></small><h3 data-preview-title></h3><p data-preview-summary></p></div></div><small class="muted" id="previewSizeLabel"></small></section>
<button class="btn btn-primary w-100 mb-3" type="submit">บันทึกข่าวประชาสัมพันธ์</button></div></div></form>
@if(Model.Id != 0){<form asp-action="Delete" method="post" data-confirm><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Model.RowVersion"/><button class="btn btn-outline-danger">ลบข่าวนี้</button></form>}
@section Scripts {<script src="~/js/announcement-editor.js" asp-append-version="true"></script>}
