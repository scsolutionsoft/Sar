@model List<Announcement>
@using SchoolPortfolioPR.Services
@{ ViewData["Title"] = "กระดานประชาสัมพันธ์"; var today = (DateTime)ViewBag.Today; var visible = Model.Where(AnnouncementSchedule.VisibleOn(today).Compile()).ToList(); }
<div class="page-head"><div><p class="eyebrow">PUBLIC RELATIONS BOARD</p><h1>กระดานประชาสัมพันธ์</h1><p class="muted">เลือกข่าว ภาพ ขนาดกรอบ และช่วงวันที่ที่ต้องการให้แสดงบนหน้าแรก</p></div><a class="btn btn-primary" asp-action="Edit">+ เพิ่มข่าวประชาสัมพันธ์</a></div>
<div class="pr-management-summary"><div><strong>@visible.Count</strong><span>กำลังแสดง</span></div><div><strong>@Model.Count(x => x.IsEnabled && x.StartDate > today)</strong><span>รอแสดง</span></div><div><strong>@Model.Count(x => x.IsEnabled && x.EndDate < today)</strong><span>หมดอายุ</span></div><a class="btn btn-outline-primary" href="/">ชมหน้าแรก ↗</a></div>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>ข่าว / ภาพประกอบ</th><th>ช่วงแสดง (เวลาไทย)</th><th>ขนาด / ลำดับ</th><th>สถานะ</th><th>จัดการ</th></tr></thead><tbody>
@foreach(var item in Model){<tr data-board-row="@item.Id"><td><div class="pr-row-title">@if(item.ImageId.HasValue){<img src="/files/@item.ImageId" alt="" loading="lazy"/>}<div><a asp-action="Edit" asp-route-id="@item.Id">@item.Title</a><small class="d-block muted">@item.Category</small></div></div></td><td>@Thai.Date(item.StartDate)<br/><small>ถึง @Thai.Date(item.EndDate)</small></td><td>@(item.Size == AnnouncementSize.Large ? "ใหญ่" : item.Size == AnnouncementSize.Medium ? "กลาง" : "เล็ก")<small class="d-block muted">ลำดับ @item.SortOrder</small></td><td><span class="count-chip">@AnnouncementSchedule.Status(item, today)</span></td><td><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id">แก้ไข</a> <a class="btn btn-sm btn-light" href="/announcements/@item.Id">ดูข่าว</a></td></tr>}
</tbody></table>@if(Model.Count == 0){<p class="empty">ยังไม่มีข่าว เริ่มจากเพิ่มข่าวประชาสัมพันธ์รายการแรก</p>}</div>
<div class="section-head"><div><p class="eyebrow">LIVE LAYOUT</p><h2>ตัวอย่างการจัดกรอบบนหน้าแรก</h2></div><small>วันที่ @Thai.Date(today) · ข่าวเรียงตามลำดับที่กำหนด</small></div>
<partial name="_AnnouncementBoard" model="visible"/>
