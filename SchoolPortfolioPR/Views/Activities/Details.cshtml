@model Activity
@{ViewData["Title"] = Model.Title; var images = (List<FileInfoView>)ViewBag.Images; var files = (List<FileInfoView>)ViewBag.Files; var coverItem = ((ActivityGalleryView)ViewBag.Gallery).Items.FirstOrDefault(x=>x.FileId==Model.CoverImageId); var coverCaption = string.IsNullOrWhiteSpace(coverItem?.Caption) ? Model.Title : coverItem.Caption;}
<div class="page-head"><div><p class="eyebrow">@Model.Category.Name · @Model.ActivityCode</p><h1>@Model.Title</h1><span class="badge-status status-@Model.Status">@Thai.Status(Model.Status)</span></div>@if(ViewBag.CanEdit){<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">แก้ไขกิจกรรม</a>}</div>
<article class="panel">@if(Model.CoverImageId.HasValue){<a class="media-trigger" href="/files/@Model.CoverImageId" data-media-preview data-media-type="image" data-media-title="@coverCaption" data-media-group="activity-@Model.Id"><img class="article-cover" src="/files/@Model.CoverImageId" alt="@Model.Title"/></a>}
<div class="article-meta"><span>@Thai.Date(Model.ActivityDate) @if(Model.EndDate.HasValue && Model.EndDate != Model.ActivityDate){<text>– @Thai.Date(Model.EndDate)</text>}</span><span>@Model.Location</span><span>@Model.Department.Name</span><span>ปีการศึกษา @Model.AcademicYear.Name</span></div><p class="lead">@Model.ShortDescription</p><div class="article-body">@Model.Description</div><div class="article-people"><p>ผู้จัด: @Model.Organizer</p><p>ครู: @string.Join(", ", Model.Teachers.Select(t => t.Teacher.Name + " (" + t.Role + ")"))</p><p>นักเรียน: @string.Join(", ", Model.Students.Select(t => t.Student.Name))</p><p class="mb-0">แท็ก: @string.Join(" · ", Model.Tags.Select(t => t.Tag.Name))</p></div></article>
<partial name="_Workflow" model="Model"/>
<partial name="_ActivityGallery" model="(ActivityGalleryView)ViewBag.Gallery"/>
<div class="panel"><div class="section-head"><div class="section-title"><span class="section-icon"><partial name="_Icon" model='"folder"'/></span><div><h2>เอกสารประกอบ</h2><small>เปิดดู PDF หรือดาวน์โหลดเอกสารได้จากที่นี่</small></div></div><span class="count-chip">@files.Count ไฟล์</span></div><partial name="_Files" model="files"/></div>
@if(ViewBag.CanEdit){<partial name="_Upload" model="Model"/>@if(images.Count > 0){<details class="panel"><summary>จัดการภาพปกและลำดับภาพ</summary><form asp-action="Images" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Id"/><p class="muted">เลือกภาพปก แล้วลากรายการหรือใช้ปุ่มขึ้น / ลง</p><div data-sortable>@foreach(var img in images){<div class="drag-item"><input type="hidden" name="order" value="@img.Id"/><label><input type="radio" name="cover" value="@img.Id" checked="@(Model.CoverImageId == img.Id)"/> @img.Name</label><button type="button" class="btn btn-sm btn-light" data-up aria-label="เลื่อนภาพขึ้น">↑</button><button type="button" class="btn btn-sm btn-light" data-down aria-label="เลื่อนภาพลง">↓</button></div>}</div><button class="btn btn-primary mt-2">บันทึกลำดับและภาพปก</button></form><div class="mt-4"><partial name="_Files" model="images"/></div></details>}}
@if(ViewBag.CanEdit){<form asp-action="Delete" method="post" data-confirm class="mt-4"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-danger">ลบกิจกรรม</button></form>}
