@model PageView<Activity>
@{ViewData["Title"] = "กิจกรรมและข่าว"; ViewBag.Page = Model.Page; ViewBag.Pages = Model.Pages;}
<div class="page-head"><div><p class="eyebrow">Activities & News</p><h1>กิจกรรมและข่าว</h1><p class="muted">รวบรวมการเรียนรู้และเรื่องราวที่น่าภาคภูมิใจ</p></div>@if(ViewBag.CanCreate == true){<a class="btn btn-primary" asp-action="Edit">+ เพิ่มกิจกรรม</a>}</div>
<div class="panel"><form method="get" class="d-flex flex-wrap gap-2 mb-4"><input name="q" value="@ViewBag.Search" class="form-control" placeholder="ค้นหาชื่อหรือรหัสกิจกรรม" aria-label="ค้นหา"/><partial name="_WorkflowFilters"/><button class="btn btn-outline-primary">ค้นหา</button></form><div class="table-responsive"><table class="table"><thead><tr><th>รหัส / กิจกรรม</th><th>วันที่</th><th>ฝ่าย</th><th>สถานะ</th></tr></thead><tbody>@foreach(var a in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@a.Id">@a.Title</a><small class="d-block">@a.ActivityCode</small></td><td>@Thai.Date(a.ActivityDate)</td><td>@a.Department.Name</td><td><span class="badge-status status-@a.Status">@Thai.Status(a.Status)</span></td></tr>}</tbody></table></div>@if(Model.Total == 0){<p class="empty">ยังไม่มีกิจกรรมในรายการนี้</p>}<partial name="_Pagination"/></div>
