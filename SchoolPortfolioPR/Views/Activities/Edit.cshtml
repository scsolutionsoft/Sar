@model ActivityForm
@{ViewData["Title"] = "บันทึกกิจกรรม";}
<div class="page-head"><div><p class="eyebrow">Activities & stories</p><h1>บันทึกกิจกรรม</h1><p class="muted">จัดเก็บข้อมูลให้ครบถ้วน เพื่อส่งต่อเรื่องราวและความสำเร็จ</p></div><a asp-action="Index" class="btn btn-light">กลับรายการ</a></div>
<form method="post" class="panel"><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All"></div>
<fieldset class="form-section"><legend><span class="form-step">1</span><span>รายละเอียดกิจกรรม<small>ชื่อและเรื่องราวที่อยากบันทึก</small></span></legend><div class="row"><div class="col-md-6"><label asp-for="ActivityCode" class="form-label"></label><input asp-for="ActivityCode" class="form-control"/><span asp-validation-for="ActivityCode"></span></div>
<div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title"></span></div>
<div class="col-12"><label asp-for="ShortDescription" class="form-label"></label><textarea asp-for="ShortDescription" class="form-control" rows="5"></textarea><span asp-validation-for="ShortDescription"></span></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description"></span></div></div></fieldset>
<fieldset class="form-section"><legend><span class="form-step">2</span><span>วันเวลาและสถานที่<small>ระบุช่วงเวลาและผู้จัดกิจกรรม</small></span></legend><div class="row"><div class="col-md-6"><label asp-for="ActivityDate" class="form-label"></label><input asp-for="ActivityDate" class="form-control"/><span asp-validation-for="ActivityDate"></span></div>
<div class="col-md-6"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control"/><span asp-validation-for="EndDate"></span></div>
<div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/><span asp-validation-for="Location"></span></div>
<div class="col-md-6"><label asp-for="Organizer" class="form-label"></label><input asp-for="Organizer" class="form-control"/><span asp-validation-for="Organizer"></span></div></div></fieldset>
<fieldset class="form-section"><legend><span class="form-step">3</span><span>จัดหมวดหมู่<small>ช่วยให้ค้นหาและออกรายงานได้สะดวก</small></span></legend><div class="row"><div class="col-md-6"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="CategoryId"></span></div>
<div class="col-md-6"><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="DepartmentId"></span></div>
<div class="col-md-6"><label asp-for="SubjectGroupId" class="form-label"></label><select asp-for="SubjectGroupId" asp-items="ViewBag.SubjectGroups" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="SubjectGroupId"></span></div>
<div class="col-md-6"><label asp-for="AcademicYearId" class="form-label"></label><select asp-for="AcademicYearId" asp-items="ViewBag.AcademicYears" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="AcademicYearId"></span></div>
<div class="col-md-6"><label asp-for="FiscalYear" class="form-label"></label><input asp-for="FiscalYear" class="form-control"/><span asp-validation-for="FiscalYear"></span></div>
<div class="col-md-6"><label asp-for="TagIds" class="form-label"></label><select asp-for="TagIds" asp-items="ViewBag.Tags" class="form-select" multiple></select><span asp-validation-for="TagIds"></span></div></div></fieldset>
<fieldset class="form-section"><legend><span class="form-step">4</span><span>ผู้ร่วมกิจกรรม<small>เชื่อมโยงผลงานไปยังแฟ้มครูและนักเรียน</small></span></legend><div class="row"><div class="col-lg-6 mb-3"><partial name="_ParticipantPicker" model='new ParticipantPickerView("TeacherIds", "ครูผู้ร่วมกิจกรรม", true, (List<ParticipantChoice>)ViewBag.TeacherChoices, Model.TeacherIds)'/></div>
<div class="col-lg-6 mb-3"><partial name="_ParticipantPicker" model='new ParticipantPickerView("StudentIds", "นักเรียนผู้ร่วมกิจกรรม", false, (List<ParticipantChoice>)ViewBag.StudentChoices, Model.StudentIds)'/></div>
<div class="col-md-6"><label asp-for="TeacherRole" class="form-label"></label><select asp-for="TeacherRole" asp-items="Html.GetEnumSelectList<TeacherRole>()" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="TeacherRole"></span></div></div></fieldset>
<fieldset class="form-section"><legend><span class="form-step">5</span><span>การแสดงผลและเผยแพร่<small>กำหนดประเภทผลงานและการแสดงบนเว็บไซต์</small></span></legend><div class="row"><div class="col-12"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" readonly placeholder="ระบบจะสร้างลิงก์ข่าวให้อัตโนมัติเมื่อบันทึก" aria-describedby="slugHelp"/><small id="slugHelp" class="form-text">ไม่ต้องกรอก ระบบสร้างชื่อไม่ซ้ำให้เองและคงชื่อเดิมเมื่อแก้ไขข่าว ลิงก์สาธารณะเปิดได้หลังเผยแพร่</small></div>
<div class="col-md-6"><label class="option-tile"><input asp-for="IsProject" class="form-check-input"/><span>@Html.DisplayNameFor(x => x.IsProject)</span></label></div>
<div class="col-md-6"><label class="option-tile"><input asp-for="IsFeatured" class="form-check-input"/><span>@Html.DisplayNameFor(x => x.IsFeatured)</span></label></div>
<div class="col-12"><label class="option-tile"><input asp-for="IsPublic" class="form-check-input"/><span>@Html.DisplayNameFor(x => x.IsPublic)</span></label></div></div></fieldset>
<div class="form-actions"><button class="btn btn-primary">บันทึก</button><a asp-action="Index" class="btn btn-light">ยกเลิก</a></div></form>

