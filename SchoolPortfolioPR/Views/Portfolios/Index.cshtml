@model List<ReportRow>
@{ViewData["Title"] = "แฟ้มผลงาน"; var f = (ReportFilter)ViewBag.Filter;}
<p class="eyebrow">Portfolio</p><h1>แฟ้มผลงานครูและนักเรียน</h1><p class="muted">เลือกครูหรือนักเรียนหนึ่งคน เพื่อรวบรวมกิจกรรม โครงการ รางวัล และเกียรติบัตร</p><form method="get" class="panel no-print"><input type="hidden" name="Kind" value="@f.Kind"/><partial name="_ReportFilters" model="f"/><div class="d-flex gap-2 mt-4"><button class="btn btn-primary">แสดงแฟ้มผลงาน</button>@if(f.TeacherId.HasValue || f.StudentId.HasValue){<button class="btn btn-outline-primary" formaction="/Reports" name="format" value="pdf" data-preview-report>ดู PDF</button><button class="btn btn-outline-primary" formaction="/Reports" name="format" value="docx">Word</button><button class="btn btn-outline-primary" formaction="/Reports" name="format" value="xlsx">Excel</button>}</div></form><div class="panel"><partial name="_ReportTable" model="Model"/></div><div class="panel"><h2>เกียรติบัตร</h2><partial name="_Files" model="(List<FileInfoView>)ViewBag.Files"/></div>

