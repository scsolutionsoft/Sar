@model PageView<WorkItem>
@{ViewData["Title"]="งานที่รอดำเนินการ";ViewBag.Page=Model.Page;ViewBag.Pages=Model.Pages;}
<div class="page-head"><div><p class="eyebrow">My work queue</p><h1>งานที่รอดำเนินการ</h1><p class="muted">เฉพาะรายการที่คุณส่งตรวจ ตรวจสอบ อนุมัติ หรือเผยแพร่ได้ตามสิทธิ์</p></div><span class="count-chip">@Model.Total รายการ</span></div>
<div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>เรื่อง</th><th>ฝ่าย</th><th>สถานะ</th><th>ขั้นตอนถัดไป</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr data-work-item="@(item.Controller)-@item.Id"><td><a asp-controller="@item.Controller" asp-action="Details" asp-route-id="@item.Id">@item.Title</a><small class="d-block">@(item.Controller=="Activities"?"กิจกรรม":"รางวัล")</small></td><td>@item.Department</td><td><span class="badge-status status-@item.Status">@Thai.Status(item.Status)</span></td><td>@(item.Status switch { WorkflowStatus.Draft or WorkflowStatus.Rejected=>"ตรวจข้อมูลและส่งตรวจ",WorkflowStatus.Submitted=>"ตรวจสอบ / ส่งกลับ",WorkflowStatus.Reviewed=>"อนุมัติ / ส่งกลับ",_=>"เผยแพร่" })</td></tr>}</tbody></table></div>@if(Model.Total==0){<div class="empty-state"><h2>ไม่มีงานค้างในขณะนี้</h2><p>เมื่อมีรายการถึงขั้นตอนของคุณ จะแสดงในหน้านี้</p><a href="/Dashboard" class="btn btn-outline-primary">กลับพื้นที่ทำงาน</a></div>}<partial name="_Pagination"/></div>
