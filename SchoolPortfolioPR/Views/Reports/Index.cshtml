@model List<ReportRow>
@{var f = (ReportFilter)ViewBag.Filter;}
<form asp-action="SavePdf" method="post" class="mb-3 no-print">@foreach(var property in typeof(ReportFilter).GetProperties()){var value=property.GetValue(f);<input type="hidden" name="@property.Name" value="@(value is DateTime date ? date.ToString("yyyy-MM-dd",System.Globalization.CultureInfo.InvariantCulture) : Convert.ToString(value,System.Globalization.CultureInfo.InvariantCulture))"/>}<button class="btn btn-outline-primary">บันทึกรายงานนี้ลงคลัง PDF ส่วนตัว</button></form>
<div class="page-head"><h1>รายงาน</h1><button type="button" class="btn btn-light no-print" data-print>พิมพ์หน้านี้</button></div><form method="get" class="panel no-print"><label class="form-label" for="Kind">รูปแบบรายงาน</label><select name="Kind" id="Kind" class="form-select">@foreach(var k in ReportService.Kinds){<option value="@k.Key" selected="@(k.Key == f.Kind)">@k.Value</option>}</select><partial name="_ReportFilters" model="f"/><div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-primary">แสดงรายงาน</button><button class="btn btn-outline-primary" name="format" value="pdf" data-preview-report>ดู PDF</button><button class="btn btn-outline-primary" name="format" value="docx">Word</button><button class="btn btn-outline-primary" name="format" value="xlsx">Excel</button></div></form><div class="panel"><h2>@ViewBag.Title · @Model.Count รายการ</h2>
@{var groups = f.Kind.Contains("Department") ? Model.GroupBy(x => x.Department) : f.Kind.Contains("Year") && f.Kind.StartsWith("Awards") || f.Kind.Contains("Level") || f.Kind.Contains("Category") || f.Kind.Contains("SubjectGroup") ? Model.GroupBy(x => x.Category) : Model.GroupBy(x => x.Date.ToString(f.Kind == "AnnualActivities" ? "yyyy" : "yyyy-MM"));}
<p class="muted">@string.Join(" · ", groups.Select(g => g.Key + ": " + g.Count()))</p><partial name="_ReportTable" model="Model"/></div>

