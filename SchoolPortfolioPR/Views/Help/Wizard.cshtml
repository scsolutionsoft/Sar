@model HelpWizardView
@{var current=Model.Topic.Steps[Model.Step-1];ViewData["Title"]=Model.Topic.Title+" · ตัวช่วยใช้งาน";}
<div class="page-head"><div><p class="eyebrow">@Model.Role</p><h1>@Model.Topic.Title</h1><p class="muted">@Model.Topic.Description</p></div><a href="/Help" class="btn btn-light">หัวข้อทั้งหมด</a></div>
<div class="help-wizard" data-help-key="@Model.StorageKey" data-help-topic="@Model.Topic.Id" data-help-step="@Model.Step" data-help-count="@Model.Topic.Steps.Count">
<nav class="panel help-step-list" aria-label="ขั้นตอนคำแนะนำ"><ol>@for(var i=0;i<Model.Topic.Steps.Count;i++){<li><a href="/Help/Wizard?topic=@Model.Topic.Id&amp;step=@(i+1)" aria-current="@(Model.Step==i+1?"step":null)"><span>@(i+1)</span>@Model.Topic.Steps[i].Title</a></li>}</ol></nav>
<section class="panel help-step-content" aria-labelledby="helpStepTitle"><div class="d-flex justify-content-between gap-2 mb-2"><small>ขั้นตอน @Model.Step จาก @Model.Topic.Steps.Count</small><small data-help-status>คำแนะนำการใช้งาน</small></div><progress value="@Model.Step" max="@Model.Topic.Steps.Count" aria-label="ความคืบหน้าคำแนะนำ"></progress><span class="section-icon my-4"><partial name="_Icon" model="Model.Topic.Icon"/></span><h2 id="helpStepTitle">@current.Title</h2><p class="help-instruction">@current.Instruction</p><a class="btn btn-primary" href="@current.Url" target="_blank" rel="noopener" data-help-action>@current.Action ↗</a><p class="form-text mt-2">เปิดหน้าทำงานในแท็บใหม่ แล้วกลับมาอ่านขั้นตอนต่อไปได้</p>
<div class="help-controls">@if(Model.Step>1){<a class="btn btn-light" href="/Help/Wizard?topic=@Model.Topic.Id&amp;step=@(Model.Step-1)" data-help-previous>← ก่อนหน้า</a>}else{<a class="btn btn-light" href="/Help">กลับหัวข้อ</a>}
@if(Model.Step<Model.Topic.Steps.Count){<a class="btn btn-outline-primary" href="/Help/Wizard?topic=@Model.Topic.Id&amp;step=@(Model.Step+1)" data-help-next>ถัดไป →</a>}else{<a class="btn btn-success" href="/Help" data-help-complete>อ่านครบแล้ว ✓</a>}</div><a class="help-restart" href="/Help/Wizard?topic=@Model.Topic.Id&amp;step=1" data-help-restart>เริ่มอ่านหัวข้อนี้ใหม่</a>
</section></div>
@section Scripts{<script src="~/js/help.js" asp-append-version="true"></script>}
