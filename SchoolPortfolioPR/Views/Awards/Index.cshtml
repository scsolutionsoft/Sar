@model PageView<Award>
@inject AccessService Access
@{ViewData["Title"] = Access.IsStudent ? "รางวัลและเกียรติบัตรของฉัน" : "รางวัลและเกียรติบัตร"; ViewBag.Page = Model.Page; ViewBag.Pages = Model.Pages;}
<div class="page-head"><div><p class="eyebrow">Achievements</p><h1>@ViewData["Title"]</h1>@if(Access.IsStudent){<p class="text-muted">แสดงเฉพาะรางวัลที่เผยแพร่แล้วและมีชื่อคุณเป็นผู้รับ เกียรติบัตรจะแสดงเมื่อเจ้าหน้าที่ระบุไฟล์ให้คุณ</p>}</div>@if(ViewBag.CanCreate == true){<a class="btn btn-primary" asp-action="Edit">+ เพิ่มรางวัล</a>}</div><div class="panel"><form method="get" class="d-flex flex-wrap gap-2 mb-4"><input name="q" value="@ViewBag.Search" class="form-control" placeholder="ค้นหารางวัลหรือการแข่งขัน" aria-label="ค้นหา"/><partial name="_WorkflowFilters"/><button class="btn btn-outline-primary">ค้นหา</button></form><div class="table-responsive"><table class="table"><thead><tr><th>รางวัล</th><th>วันที่</th><th>ระดับ</th><th>ฝ่าย</th><th>สถานะ</th></tr></thead><tbody>@foreach(var a in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@a.Id">@a.AwardName</a><small class="d-block">@a.CompetitionName</small></td><td>@Thai.Date(a.AwardDate)</td><td>@Thai.Level(a.AwardLevel)</td><td>@a.Department.Name</td><td><span class="badge-status status-@a.Status">@Thai.Status(a.Status)</span></td></tr>}</tbody></table></div>@if(Model.Total == 0){<p class="empty">ยังไม่มีรางวัลในรายการนี้</p>}<partial name="_Pagination"/></div>
