@model AwardForm
@{ViewData["Title"] = "บันทึกรางวัล";}
<div class="page-head"><div><p class="eyebrow">Awards & achievements</p><h1>บันทึกรางวัล</h1><p class="muted">จัดเก็บข้อมูลให้ครบถ้วน เพื่อส่งต่อเรื่องราวและความสำเร็จ</p></div><a asp-action="Index" class="btn btn-light">กลับรายการ</a></div>
<form method="post" class="panel"><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All"></div>
<fieldset class="form-section"><legend><span class="form-step">1</span><span>รายละเอียดรางวัล<small>ความสำเร็จและเวทีการแข่งขัน</small></span></legend><div class="row"><div class="col-md-6"><label asp-for="AwardName" class="form-label"></label><input asp-for="AwardName" class="form-control"/><span asp-validation-for="AwardName"></span></div>
<div class="col-md-6"><label asp-for="CompetitionName" class="form-label"></label><input asp-for="CompetitionName" class="form-control"/><span asp-validation-for="CompetitionName"></span></div>
<div class="col-md-6"><label asp-for="AwardLevel" class="form-label"></label><select asp-for="AwardLevel" asp-items="Html.GetEnumSelectList<AwardLevel>()" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="AwardLevel"></span></div>
<div class="col-md-6"><label asp-for="AwardRank" class="form-label"></label><input asp-for="AwardRank" class="form-control"/><span asp-validation-for="AwardRank"></span></div>
<div class="col-md-6"><label asp-for="Organizer" class="form-label"></label><input asp-for="Organizer" class="form-control"/><span asp-validation-for="Organizer"></span></div>
<div class="col-md-6"><label asp-for="AwardDate" class="form-label"></label><input asp-for="AwardDate" class="form-control"/><span asp-validation-for="AwardDate"></span></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description"></span></div></div></fieldset>
<fieldset class="form-section"><legend><span class="form-step">2</span><span>จัดหมวดหมู่และเชื่อมกิจกรรม<small>จัดเก็บรางวัลตามปีการศึกษาและฝ่าย</small></span></legend><div class="row"><div class="col-md-6"><label asp-for="AcademicYearId" class="form-label"></label><select asp-for="AcademicYearId" asp-items="ViewBag.AcademicYears" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="AcademicYearId"></span></div>
<div class="col-md-6"><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="DepartmentId"></span></div>
<div class="col-md-6"><label asp-for="SubjectGroupId" class="form-label"></label><select asp-for="SubjectGroupId" asp-items="ViewBag.SubjectGroups" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="SubjectGroupId"></span></div>
<div class="col-md-6"><label asp-for="ActivityId" class="form-label"></label><select asp-for="ActivityId" asp-items="ViewBag.Activities" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="ActivityId"></span></div></div></fieldset>
<fieldset class="form-section"><legend><span class="form-step">3</span><span>ผู้ได้รับรางวัลและครูผู้ดูแล<small>นำข้อมูลไปแสดงในแฟ้มผลงาน</small></span></legend><div class="row"><div class="col-lg-6 mb-3"><partial name="_ParticipantPicker" model='new ParticipantPickerView("TeacherIds", "ครูผู้ร่วมกิจกรรม", true, (List<ParticipantChoice>)ViewBag.TeacherChoices, Model.TeacherIds)'/></div>
<div class="col-lg-6 mb-3"><partial name="_ParticipantPicker" model='new ParticipantPickerView("StudentIds", "นักเรียนผู้ร่วมกิจกรรม", false, (List<ParticipantChoice>)ViewBag.StudentChoices, Model.StudentIds)'/></div>
<div class="col-md-6"><label asp-for="TeacherRole" class="form-label"></label><select asp-for="TeacherRole" asp-items="Html.GetEnumSelectList<TeacherRole>()" class="form-select"><option value="">เลือก</option></select><span asp-validation-for="TeacherRole"></span></div>
<div class="col-md-6"><label class="option-tile"><input asp-for="IsPublic" class="form-check-input"/><span>@Html.DisplayNameFor(x => x.IsPublic)</span></label></div></div></fieldset>
<div class="form-actions"><button class="btn btn-primary">บันทึก</button><a asp-action="Index" class="btn btn-light">ยกเลิก</a></div></form>

