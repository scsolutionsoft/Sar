@model Award
@{ViewData["Title"] = Model.AwardName;}
<div class="page-head"><div><p class="eyebrow">@Thai.Level(Model.AwardLevel) · @Model.AwardRank</p><h1>@Model.AwardName</h1><span class="badge-status status-@Model.Status">@Thai.Status(Model.Status)</span></div>@if(ViewBag.CanEdit){<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">แก้ไขรางวัล</a>}</div><div class="panel"><h2>@Model.CompetitionName</h2><p>@Thai.Date(Model.AwardDate) · @Model.Department.Name · ปีการศึกษา @Model.AcademicYear.Name</p><p>ผู้จัด: @Model.Organizer</p><div class="article-body">@Model.Description</div><p class="mt-4">ครู: @string.Join(", ", Model.Teachers.Select(t => t.Teacher.Name + " (" + t.Role + ")"))</p><p>นักเรียน: @string.Join(", ", Model.Students.Select(t => t.Student.Name))</p></div><partial name="_Workflow" model="Model"/>
@if(ViewBag.CanEdit){<partial name="_Upload" model="Model"/>}<div class="panel"><h2>เกียรติบัตร</h2><partial name="_Files" model="(List<FileInfoView>)ViewBag.Files"/></div>
@if(ViewBag.CanEdit){<form asp-action="Delete" method="post" data-confirm><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-danger">ลบรางวัล</button></form>}
@if(ViewBag.CanEdit && ((List<CertificateRecipientView>)ViewBag.CertificateAssignments).Count>0){<section class="panel mt-4"><h2>กำหนดเจ้าของเกียรติบัตร</h2><p class="muted">นักเรียนเห็นเฉพาะไฟล์ที่ระบุชื่อตน ไฟล์ที่ยังไม่ระบุผู้รับจะไม่แสดงในบัญชีนักเรียน</p>@foreach(CertificateRecipientView file in ViewBag.CertificateAssignments){<form asp-action="AssignCertificate" method="post" class="border rounded p-3 mb-3" data-certificate-assignment="@file.FileId"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="fileId" value="@file.FileId"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><label for="recipient-@file.FileId" class="form-label">@file.Name</label><div class="d-flex gap-2 flex-wrap"><select id="recipient-@file.FileId" name="studentId" class="form-select"><option value="">เอกสารส่วนกลาง — ไม่แสดงในบัญชีนักเรียน</option>@foreach(Student student in ViewBag.CertificateStudents){<option value="@student.Id" selected="@(file.StudentId==student.Id)">@student.Name · @student.Code</option>}</select><button class="btn btn-outline-primary">บันทึกผู้รับ</button></div></form>}</section>}
