@model PersonalWorkForm
@{var label=WorkKinds.Labels.GetValueOrDefault(Model.Kind,"ผลงาน");ViewData["Title"]=(Model.Id==0?"เพิ่ม":"แก้ไข")+label+"ของฉัน";}
<div class="page-head"><div><p class="eyebrow">MAKE IT YOURS</p><h1>@ViewData["Title"]</h1><p class="muted">เริ่มจากชื่อและวันที่ แล้วเติมรายละเอียดหรือแนบหลักฐานได้ตามต้องการ</p></div><a href="/MyWorks?kind=@Model.Kind" class="btn btn-light">กลับคอลเลกชัน</a></div>
@if(Model.Id==0){<nav class="mywork-type-picker" aria-label="เลือกประเภทผลงาน">@foreach(var type in WorkKinds.Labels){<a href="/MyWorks/Edit?kind=@type.Key" class="tone-@WorkKinds.Tone(type.Key) @(type.Key==Model.Kind?"selected":"")"><partial name="_Icon" model="WorkKinds.Icon(type.Key)"/>@type.Value</a>}</nav>}
<form method="post" enctype="multipart/form-data" class="mywork-editor"><input asp-for="Id" type="hidden"/><input asp-for="Kind" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>
<section class="panel"><div class="section-title"><span class="section-icon"><partial name="_Icon" model="WorkKinds.Icon(Model.Kind)"/></span><div><h2>รายละเอียด@(label)</h2><small class="muted">ข้อมูลนี้อยู่ในพื้นที่ส่วนตัวของคุณ</small></div></div><div class="row g-3 mt-1"><div class="col-12"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control form-control-lg" maxlength="250" required placeholder="เช่น รางวัลโครงงานวิทยาศาสตร์ หรือกิจกรรมจิตอาสา"/><span asp-validation-for="Title"></span></div><div class="col-md-6"><label asp-for="WorkDate" class="form-label"></label><input asp-for="WorkDate" class="form-control" required/><span asp-validation-for="WorkDate"></span></div><div class="col-md-6"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" list="workCategories" maxlength="80"/><datalist id="workCategories"><option>วิชาการ</option><option>กีฬา</option><option>ศิลปะและดนตรี</option><option>จิตอาสา</option><option>อบรมและพัฒนาทักษะ</option><option>ทั่วไป</option></datalist></div><div class="col-md-6"><label asp-for="Organizer" class="form-label"></label><input asp-for="Organizer" class="form-control" maxlength="200"/></div><div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" maxlength="200"/></div><div class="col-md-6"><label asp-for="Role" class="form-label"></label><input asp-for="Role" class="form-control" maxlength="150" placeholder="เช่น ผู้เข้าร่วม ผู้จัดกิจกรรม หรือหัวหน้าทีม"/></div>@if(Model.Kind is PersonalWorkKind.Award or PersonalWorkKind.Certificate){<div class="col-md-6"><label asp-for="Achievement" class="form-label"></label><input asp-for="Achievement" class="form-control" maxlength="100" placeholder="เช่น ชนะเลิศ ระดับจังหวัด หรือผ่านการอบรม"/></div>}<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5" maxlength="4000" placeholder="เล่าเรื่องราว สิ่งที่ทำ ผลสำเร็จ หรือทักษะที่ได้เรียนรู้"></textarea></div></div></section>
<section class="panel mywork-upload-box"><div class="section-title"><span class="section-icon"><partial name="_Icon" model='"image"'/></span><div><h2>แนบภาพและหลักฐาน</h2><small>เลือกตอนนี้ หรือเพิ่มภายหลังได้</small></div></div><label asp-for="Uploads" class="form-label mt-3">@(Model.Kind==PersonalWorkKind.Album?"เลือกรูปสำหรับอัลบั้ม":"เลือกรูปภาพหรือไฟล์ PDF")</label><input asp-for="Uploads" type="file" class="form-control" multiple accept="@(Model.Kind==PersonalWorkKind.Album?".png,.jpg,.jpeg,.webp":".png,.jpg,.jpeg,.webp,.pdf")"/><p class="form-text">ครั้งละไม่เกิน 20 ไฟล์ ไฟล์ละ 10 MB และรวมไม่เกิน 50 MB เพิ่มคำบรรยายและลิงก์คลาวด์ได้หลังบันทึก</p></section>
<div class="mywork-savebar"><span><partial name="_Icon" model='"shield"'/> เจ้าของบัญชีเท่านั้นที่เปิดดูได้</span><div><a href="/MyWorks?kind=@Model.Kind" class="btn btn-light">ยกเลิก</a><button class="btn btn-primary" type="submit">บันทึก@(label)</button></div></div></form>
