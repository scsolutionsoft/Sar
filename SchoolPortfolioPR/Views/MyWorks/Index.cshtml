@model PageView<PersonalWorkCard>
@{ViewData["Title"]="ผลงานของฉัน";var counts=(Dictionary<PersonalWorkKind,int>)ViewBag.Counts;PersonalWorkKind? selected=ViewBag.Kind;ViewBag.Page=Model.Page;ViewBag.Pages=Model.Pages;}
<section class="mywork-hero"><div><p class="eyebrow">MY COLLECTION</p><h1>ทุกความสำเร็จ<br/><span>เก็บไว้ในพื้นที่ของคุณ</span></h1><p>บันทึกกิจกรรม รางวัล เกียรติบัตร และเรื่องราวผ่านภาพ<br/>ค้นหาง่าย พร้อมเปิดดูหลักฐานได้ทุกเมื่อ</p><span class="mywork-private"><partial name="_Icon" model='"shield"'/> เห็นและจัดการได้เฉพาะคุณ</span></div><div class="mywork-hero-art" aria-hidden="true"><partial name="_Icon" model='"award"'/><span>MY<br/>ACHIEVEMENTS</span></div></section>
<div class="mywork-shortcuts">@foreach(var type in WorkKinds.Labels){<a class="mywork-shortcut tone-@WorkKinds.Tone(type.Key)" href="/MyWorks/Edit?kind=@type.Key"><span class="section-icon"><partial name="_Icon" model="WorkKinds.Icon(type.Key)"/></span><div><strong>เพิ่ม@(type.Value)</strong><small>@counts.GetValueOrDefault(type.Key) รายการในคลัง</small></div><span class="mywork-plus">+</span></a>}</div>
<section class="panel mywork-browser"><div class="section-head"><div><p class="eyebrow">YOUR PERSONAL SPACE</p><h2>คอลเลกชันของฉัน</h2></div><span class="count-chip">@Model.Total รายการ</span></div><nav class="mywork-tabs" aria-label="ประเภทผลงาน"><a class="@(!selected.HasValue?"selected":"")" href="/MyWorks" aria-current="@(!selected.HasValue?"page":null)">ทั้งหมด</a>@foreach(var type in WorkKinds.Labels){<a href="/MyWorks?kind=@type.Key" class="@(selected==type.Key?"selected":"")" aria-current="@(selected==type.Key?"page":null)">@type.Value <span>@counts.GetValueOrDefault(type.Key)</span></a>}</nav><form method="get" class="mywork-search"><input type="hidden" name="kind" value="@selected"/><input name="q" value="@ViewBag.Search" class="form-control" placeholder="ค้นหาชื่อ หมวดหมู่ หรือคำบรรยาย" aria-label="ค้นหาผลงานของฉัน"/><button class="btn btn-primary">ค้นหา</button>@if(!string.IsNullOrWhiteSpace((string?)ViewBag.Search)){<a class="btn btn-light" href="/MyWorks?kind=@selected">ล้าง</a>}</form></section>
<div class="mywork-grid">@foreach(var item in Model.Items){<article class="mywork-card tone-@WorkKinds.Tone(item.Kind)" data-work-id="@item.Id"><a href="/MyWorks/Details/@item.Id" class="mywork-cover">@if(item.CoverId.HasValue){<img src="/files/@item.CoverId" alt="@item.Title" loading="lazy"/>}else{<partial name="_Icon" model="WorkKinds.Icon(item.Kind)"/>}<span class="mywork-kind">@WorkKinds.Labels[item.Kind]</span></a><div class="mywork-card-copy"><small>@Thai.Date(item.Date) · @item.Category</small><h2><a href="/MyWorks/Details/@item.Id">@item.Title</a></h2><p>@(string.IsNullOrWhiteSpace(item.Description)?"เก็บรายละเอียดและหลักฐานของคุณไว้ที่นี่":item.Description)</p><div class="mywork-card-footer"><span>@item.MediaCount ไฟล์ / ลิงก์</span><a href="/MyWorks/Details/@item.Id">เปิดดู →</a><a href="/MyWorks/Edit/@item.Id" aria-label="แก้ไข @item.Title">แก้ไข</a></div></div></article>}</div>
@if(Model.Total==0){<section class="panel mywork-empty"><span class="section-icon"><partial name="_Icon" model='"folder"'/></span><h2>@(string.IsNullOrWhiteSpace((string?)ViewBag.Search)?"เริ่มเก็บผลงานชิ้นแรกของคุณ":"ไม่พบรายการที่ค้นหา")</h2><p>เลือกประเภทด้านบนเพื่อเพิ่มกิจกรรม รางวัล เกียรติบัตร หรืออัลบั้มภาพ</p><a href="/MyWorks/Edit?kind=@(selected??PersonalWorkKind.Activity)" class="btn btn-primary">+ เพิ่มผลงานของฉัน</a></section>}
<partial name="_Pagination"/>
