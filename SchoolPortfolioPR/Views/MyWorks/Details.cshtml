@model PersonalWorkDetail
@{var w=Model.Work;var version=Convert.ToBase64String(w.RowVersion);ViewData["Title"]=w.Title;}
<div class="page-head"><div><p class="eyebrow">MY @w.Kind.ToString().ToUpperInvariant()</p><h1>@w.Title</h1><div class="d-flex gap-2 flex-wrap"><span class="count-chip">@WorkKinds.Labels[w.Kind]</span><span class="mywork-private"><partial name="_Icon" model='"shield"'/> ส่วนตัว</span></div></div><div class="d-flex gap-2"><a href="/MyWorks?kind=@w.Kind" class="btn btn-light">กลับคอลเลกชัน</a><a href="/MyWorks/Edit/@w.Id" class="btn btn-primary">แก้ไขข้อมูล</a></div></div>
<div class="mywork-detail-grid"><article class="panel"><h2>เรื่องราวของผลงาน</h2><p class="mywork-description">@(string.IsNullOrWhiteSpace(w.Description)?"ยังไม่ได้เพิ่มรายละเอียด สามารถกดแก้ไขข้อมูลเพื่อเล่าเรื่องราวของผลงานนี้":w.Description)</p>@if(!string.IsNullOrWhiteSpace(w.Achievement)){<div class="mywork-achievement"><partial name="_Icon" model='"award"'/><strong>@w.Achievement</strong></div>}</article><aside class="panel mywork-facts"><h2>ข้อมูลสำคัญ</h2><dl><dt>วันที่</dt><dd>@Thai.Date(w.WorkDate)</dd><dt>หมวดหมู่</dt><dd>@w.Category</dd>@if(!string.IsNullOrWhiteSpace(w.Organizer)){<dt>ผู้จัด / หน่วยงาน</dt><dd>@w.Organizer</dd>}@if(!string.IsNullOrWhiteSpace(w.Location)){<dt>สถานที่</dt><dd>@w.Location</dd>}@if(!string.IsNullOrWhiteSpace(w.Role)){<dt>บทบาทของฉัน</dt><dd>@w.Role</dd>}</dl></aside></div>
<section class="panel" id="workMedia"><div class="section-head"><div class="section-title"><span class="section-icon"><partial name="_Icon" model='"folder"'/></span><div><h2>ภาพและหลักฐานของฉัน</h2><small>ภาพ/PDF เปิดพรีวิว · ลิงก์คลาวด์เปิดต้นทาง</small></div></div><span class="count-chip">@Model.Media.Count รายการ</span></div>
<div class="mywork-media-grid">@foreach(var media in Model.Media){var title=string.IsNullOrWhiteSpace(media.Caption)?media.Name:media.Caption;var image=media.ContentType.StartsWith("image/");<article class="mywork-media-card" data-work-media="@media.Id">
@if(media.FileId.HasValue){<a href="/files/@media.FileId" class="mywork-media-preview @(image?"":"mywork-pdf")" data-media-preview data-media-type="@(image?"image":"pdf")" data-media-title="@title" data-media-group="mywork-@w.Id">@if(image){<img src="/files/@media.FileId" alt="@title" loading="lazy"/>}else{<partial name="_Icon" model='"file"'/><strong>PDF</strong>}<span>เปิดพรีวิว</span></a>}
else{<a href="@media.ExternalUrl" target="_blank" rel="noopener noreferrer" class="mywork-media-preview mywork-cloud"><partial name="_Icon" model='"image"'/><strong>ภาพ / หลักฐานบนคลาวด์</strong><small>@(new Uri(media.ExternalUrl!).Host)</small><span>เปิดลิงก์ต้นทาง ↗</span></a>}
<div class="mywork-media-copy"><p>@title</p>@if(media.FileId.HasValue){<a class="mywork-download" href="/files/@media.FileId?download=true">ดาวน์โหลดไฟล์ ↓</a>}
<details class="mywork-caption-editor"><summary>แก้ไขคำบรรยาย@(media.FileId.HasValue?"":" / ลิงก์")</summary><form asp-action="Media" method="post" class="mt-3"><input type="hidden" name="id" value="@w.Id"/><input type="hidden" name="mediaId" value="@media.Id"/><input type="hidden" name="rowVersion" value="@version"/><label for="caption-@media.Id" class="form-label">คำบรรยาย</label><textarea id="caption-@media.Id" name="caption" class="form-control" maxlength="500" rows="3">@media.Caption</textarea>@if(!media.FileId.HasValue){<label for="url-@media.Id" class="form-label mt-2">URL คลาวด์</label><input id="url-@media.Id" name="url" class="form-control" type="url" value="@media.ExternalUrl" maxlength="2048" required/>}<button class="btn btn-sm btn-primary mt-2">บันทึกคำบรรยาย</button></form></details>
@if(media.ContentType=="application/pdf"){<form asp-action="SavePdf" method="post" class="mt-3"><input type="hidden" name="id" value="@w.Id"/><input type="hidden" name="mediaId" value="@media.Id"/><button class="btn btn-sm btn-outline-primary">เก็บ PDF เข้าคลังส่วนตัว</button></form>}
<form asp-action="DeleteMedia" method="post" data-confirm class="mt-3"><input type="hidden" name="id" value="@w.Id"/><input type="hidden" name="mediaId" value="@media.Id"/><input type="hidden" name="rowVersion" value="@version"/><button class="btn btn-sm btn-outline-danger">นำรายการนี้ออก</button></form></div></article>}
</div>@if(Model.Media.Count==0){<div class="mywork-empty"><span class="section-icon"><partial name="_Icon" model='"image"'/></span><h3>เติมภาพและหลักฐานให้ผลงานของคุณ</h3><p>เริ่มจากรูปภาพ PDF หรือลิงก์อัลบั้มที่คุณเก็บไว้บนคลาวด์</p></div>}
</section>
<div class="mywork-add-grid"><details class="panel mywork-add-pane" open><summary><span class="section-icon"><partial name="_Icon" model='"image"'/></span><span>เพิ่มไฟล์จากอุปกรณ์<small>ภาพในระบบและ PDF เปิดด้วยป๊อปอัป</small></span></summary><form asp-action="Upload" method="post" enctype="multipart/form-data" class="mt-4" data-work-upload><input type="hidden" name="id" value="@w.Id"/><input type="hidden" name="rowVersion" value="@version"/><label for="workFiles" class="form-label">เลือก@(w.Kind==PersonalWorkKind.Album?"รูปภาพ":"รูปภาพหรือ PDF")</label><input id="workFiles" type="file" name="files" multiple required class="form-control" accept="@(w.Kind==PersonalWorkKind.Album?".png,.jpg,.jpeg,.webp":".png,.jpg,.jpeg,.webp,.pdf")"/><small class="form-text">ไม่เกิน 20 ไฟล์ ไฟล์ละ 10 MB รวม 50 MB</small><label for="uploadCaption" class="form-label mt-3">คำบรรยายสำหรับไฟล์ชุดนี้</label><textarea id="uploadCaption" name="caption" class="form-control" maxlength="500" rows="3" placeholder="แก้แยกรายภาพได้ภายหลัง"></textarea><button class="btn btn-primary mt-3">อัปโหลดไฟล์</button></form></details>
<details class="panel mywork-add-pane"><summary><span class="section-icon"><partial name="_Icon" model='"folder"'/></span><span>เพิ่มลิงก์จากคลาวด์<small>Google Drive, OneDrive หรือเว็บไซต์อื่น</small></span></summary><form asp-action="Link" method="post" class="mt-4" data-work-link><input type="hidden" name="id" value="@w.Id"/><input type="hidden" name="rowVersion" value="@version"/><label for="cloudUrl" class="form-label">ลิงก์แชร์ภาพ / อัลบั้ม / หลักฐาน</label><input id="cloudUrl" name="url" type="url" class="form-control" maxlength="2048" required placeholder="https://..."/><p class="form-text">เปิดต้นทางในแท็บใหม่ โดยใช้สิทธิ์แชร์ของคลาวด์นั้น</p><label for="cloudCaption" class="form-label">คำบรรยาย</label><textarea id="cloudCaption" name="caption" class="form-control" maxlength="500" rows="3"></textarea><button class="btn btn-outline-primary mt-3">บันทึกลิงก์</button></form></details></div>
<form asp-action="Delete" method="post" data-confirm class="mywork-delete"><input type="hidden" name="id" value="@w.Id"/><input type="hidden" name="rowVersion" value="@version"/><button class="btn btn-outline-danger">ลบ@(WorkKinds.Labels[w.Kind])นี้</button><small>PDF ที่เก็บเข้าคลังส่วนตัวแล้วจะยังอยู่ในคลังของคุณ</small></form>
