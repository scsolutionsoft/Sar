@model AdmissionPortfolio
@using SchoolPortfolioPR.Services
@{ViewData["Title"]=Model.Title;var checks=(List<PortfolioCheck>)ViewBag.Checklist;}
<div class="page-head"><div><p class="eyebrow">MY ADMISSION PORTFOLIO</p><h1>@Model.Title</h1><p class="muted">@Model.FullName · @Model.TargetFaculty</p></div><div class="d-flex gap-2"><a class="btn btn-light" asp-action="Edit" asp-route-id="@Model.Id">แก้ไขประวัติ / ธีม</a><a class="btn btn-primary" asp-action="Entry" asp-route-portfolioId="@Model.Id">+ เพิ่มผลงาน</a></div></div>
<div class="row g-4"><div class="col-xl-8"><section class="panel"><div class="section-head"><h2>ผลงานที่คัดเลือก</h2><span class="count-chip">@Model.Entries.Count รายการ</span></div>
@foreach(var e in Model.Entries.OrderBy(x=>x.SortOrder).ThenBy(x=>x.Id)){<article class="folio-entry-card" data-entry-id="@e.Id">@if(e.ImageId.HasValue){<a href="/files/@e.ImageId" data-media-preview data-media-type="image" data-media-title="@e.Title" data-media-group="folio-@Model.Id"><img src="/files/@e.ImageId" alt="@e.Title"/></a>}<div><small>@PersonalInput.Section(e.Section) · @Thai.Date(e.Date)</small><h3>@e.Title</h3><p class="muted">@e.Role</p><a class="btn btn-sm btn-light" asp-action="Entry" asp-route-portfolioId="@Model.Id" asp-route-id="@e.Id">แก้ไขผลงาน</a><form asp-action="DeleteEntry" method="post" data-confirm class="d-inline"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="portfolioId" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(e.RowVersion)"/><input type="hidden" name="portfolioVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-sm btn-outline-danger">ลบ</button></form></div></article>}
@if(Model.Entries.Count==0){<p class="empty">เริ่มจากผลงานที่คุณภูมิใจ เช่น โครงงาน กิจกรรม รางวัล หรือจิตอาสา</p>}
@if(Model.Entries.Count>1){<details class="mt-3"><summary>เรียงลำดับผลงาน</summary><form asp-action="Order" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><div data-sortable>@foreach(var e in Model.Entries.OrderBy(x=>x.SortOrder).ThenBy(x=>x.Id)){<div class="drag-item"><input type="hidden" name="order" value="@e.Id"/><span>@e.Title</span><button type="button" class="btn btn-sm btn-light" data-up aria-label="เลื่อนขึ้น">↑</button><button type="button" class="btn btn-sm btn-light" data-down aria-label="เลื่อนลง">↓</button></div>}</div><button class="btn btn-primary mt-3">บันทึกลำดับ</button></form></details>}</section>
<section class="panel"><div class="section-head"><h2>ตัวอย่างการจัดหน้า</h2><a asp-action="Preview" asp-route-id="@Model.Id" target="_blank" rel="noopener">ขยายตัวอย่าง ↗</a></div><p class="muted">ตัวอย่างส่วนเนื้อหา ส่วนเอกสารหลักฐานจะรวมใน PDF เมื่อสร้างเล่ม</p><div class="folio-preview-shell"><iframe class="folio-preview" src="/Admissions/Preview/@Model.Id" title="ตัวอย่างแฟ้มสะสมผลงาน" loading="lazy"></iframe></div></section></div>
<div class="col-xl-4"><section class="panel"><h2>รายการเตรียมข้อมูล</h2><p class="muted">ครบ @checks.Count(x=>x.Complete) / @checks.Count หัวข้อ</p><ul class="folio-checklist">@foreach(var c in checks){<li class="@(c.Complete?"complete":"")"><span>@(c.Complete?"✓":"○")</span>@c.Label</li>}</ul><small>ตรวจเกณฑ์และหลักฐานจริงตามประกาศของคณะก่อนยื่น</small></section><section class="panel"><h2>สร้างเล่ม PDF</h2><p>ธีม @Model.Theme · ไม่เกิน @Model.MaxPages หน้า / @Model.MaxMegabytes MB</p><p class="muted">@(Model.IncludeEvidence?"รวมหลักฐาน PDF แนบท้ายเล่ม":"ส่งออกเฉพาะหน้าผลงาน")</p><form asp-action="Generate" method="post" data-generating><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-primary w-100" id="generatePortfolio">สร้าง / อัปเดต PDF</button><small class="generate-status" hidden>กำลังจัดหน้าและรวมเอกสาร กรุณารอสักครู่…</small></form>@if(Model.PdfFileId.HasValue){<div class="mt-3"><a class="btn btn-outline-primary w-100 mb-2" asp-action="Viewer" asp-route-id="@Model.Id">เปิดอ่านแบบพลิกหน้า · @Model.ExportedPages หน้า</a><a class="btn btn-light w-100" href="/files/@Model.PdfFileId?download=true">ดาวน์โหลด PDF</a></div>}else{<small class="d-block mt-3">บันทึกแก้ไขแล้วให้สร้าง PDF ใหม่เพื่อใช้ข้อมูลล่าสุด</small>}</section><section class="panel"><h2>หลักฐานแนบท้าย</h2>@foreach(var d in Model.Documents.OrderBy(x=>x.SortOrder)){<p><a href="/files/@d.PersonalDocument.FileId" data-media-preview data-media-type="pdf" data-media-title="@d.PersonalDocument.Title">@d.PersonalDocument.Title</a></p>}<a asp-controller="Documents" asp-action="Index">เปิดคลัง PDF →</a></section><form asp-action="Delete" method="post" data-confirm><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-danger">ลบแฟ้มนี้</button></form></div></div>
@section Scripts{<script src="~/js/portfolio-editor.js" asp-append-version="true"></script>}
