@model AdmissionForm
@{ViewData["Title"]="ออกแบบแฟ้มสะสมผลงาน";var docs=(List<PersonalDocument>)ViewBag.Documents;}
<div class="page-head"><div><p class="eyebrow">PORTFOLIO STUDIO</p><h1>ออกแบบแฟ้มสะสมผลงาน</h1><p class="muted">แม่แบบกลางสำหรับปรับตามคณะและรอบรับสมัครของคุณ</p></div><a class="btn btn-light" asp-action="Index">แฟ้มทั้งหมด</a></div>
<form method="post" enctype="multipart/form-data" id="admissionForm"><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-4"><div class="col-xl-8">
<section class="panel"><h2>01 · ประวัติและการศึกษา</h2><div class="row g-3"><div class="col-12"><label asp-for="Title"></label><input asp-for="Title" class="form-control" required/></div><div class="col-md-6"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" required/></div><div class="col-md-6"><label asp-for="School"></label><input asp-for="School" class="form-control" required/></div><div class="col-md-6"><label asp-for="StudyPlan"></label><input asp-for="StudyPlan" class="form-control"/></div><div class="col-md-3"><label asp-for="GraduationYear"></label><input asp-for="GraduationYear" class="form-control"/></div><div class="col-md-3"><label asp-for="Gpax"></label><input asp-for="Gpax" class="form-control" type="number" min="0" max="4" step="0.01"/></div><div class="col-md-6"><label asp-for="ContactEmail"></label><input asp-for="ContactEmail" class="form-control" type="email"/></div><div class="col-md-6"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/></div><div class="col-12"><label asp-for="Bio"></label><textarea asp-for="Bio" class="form-control" rows="4" maxlength="1200"></textarea></div><div class="col-12"><label asp-for="Education"></label><textarea asp-for="Education" class="form-control" rows="3" placeholder="2567–2570 | มัธยมศึกษาตอนปลาย โรงเรียน…"></textarea></div></div></section>
<section class="panel"><h2>02 · เป้าหมายและแรงบันดาลใจ</h2><div class="row g-3"><div class="col-md-6"><label asp-for="TargetUniversity"></label><input asp-for="TargetUniversity" class="form-control"/></div><div class="col-md-6"><label asp-for="TargetFaculty"></label><input asp-for="TargetFaculty" class="form-control"/></div><div class="col-md-6"><label asp-for="AdmissionRound"></label><input asp-for="AdmissionRound" class="form-control"/></div><div class="col-md-6"><label asp-for="RequirementsUrl"></label><input asp-for="RequirementsUrl" class="form-control" type="url"/></div><div class="col-12"><label asp-for="Motivation"></label><textarea asp-for="Motivation" class="form-control" rows="6" maxlength="2200" placeholder="ประสบการณ์ใดทำให้สนใจสาขานี้ และเตรียมตัวอย่างไร"></textarea></div><div class="col-12"><label asp-for="Goals"></label><textarea asp-for="Goals" class="form-control" rows="3" maxlength="1000"></textarea></div></div></section>
<section class="panel"><h2>03 · ทักษะและหลักฐาน</h2><label asp-for="Skills"></label><textarea asp-for="Skills" class="form-control mb-3" rows="5" placeholder="การนำเสนอ | 80&#10;การทำงานเป็นทีม | 90&#10;ภาษาอังกฤษ | ระดับ B1"></textarea><p class="muted">ตัวเลข 0–100 จะแสดงเป็นกราฟประเมินตนเอง ใช้ข้อความแทนได้</p><h3>เอกสารแนบท้ายเล่ม</h3><p class="muted">เลือกผลการเรียน หนังสือรับรอง หรือใบประกาศจากคลัง PDF แล้วลากเพื่อเรียงลำดับ</p><div data-sortable>@foreach(var d in docs.OrderBy(x=>{var n=Array.IndexOf(Model.DocumentIds,x.Id);return n<0?int.MaxValue:n;})){<div class="drag-item"><label><input type="checkbox" name="DocumentIds" value="@d.Id" checked="@Model.DocumentIds.Contains(d.Id)"/> @d.Title <small>(@d.Pages หน้า)</small></label><button type="button" class="btn btn-sm btn-light" data-up aria-label="เลื่อนขึ้น">↑</button><button type="button" class="btn btn-sm btn-light" data-down aria-label="เลื่อนลง">↓</button></div>}</div><a asp-controller="Documents" asp-action="Index" class="d-block mt-3">จัดการคลังเอกสาร →</a></section>
</div><div class="col-xl-4"><section class="panel"><h2>รูปแบบอินโฟกราฟิก</h2><div class="folio-theme-options">@foreach(var theme in Enum.GetValues<PortfolioTheme>()){<label class="theme-@theme.ToString().ToLowerInvariant()"><input asp-for="Theme" type="radio" value="@theme" id="theme-@theme"/><span class="folio-theme-swatch">PORTFOLIO</span><strong>@(theme==PortfolioTheme.Academic?"Academic · น้ำเงิน":theme==PortfolioTheme.Botanical?"Botanical · เขียว":"Creative · ส้ม")</strong></label>}</div><div class="mt-3"><label>ภาพปก / ภาพบุคคล</label><input asp-for="PortraitUpload" class="form-control" type="file" accept="image/jpeg,image/png,image/webp"/>@if(Model.CurrentPortraitId.HasValue){<img class="folio-current-photo" src="/files/@Model.CurrentPortraitId" alt="ภาพปกปัจจุบัน"/><label><input asp-for="RemovePortrait"/> ลบภาพปกเดิม</label>}</div></section>
<section class="panel"><h2>จัดองค์ประกอบเล่ม</h2><label class="d-block mb-3"><input asp-for="IncludeContents"/> มีสารบัญ</label><label class="d-block mb-3"><input asp-for="IncludeClosing"/> มีหน้าปิดท้าย</label><label class="d-block mb-3"><input asp-for="IncludeEvidence"/> รวม PDF หลักฐานท้ายเล่ม</label><label asp-for="MaxPages"></label><input asp-for="MaxPages" class="form-control mb-3" min="1" max="100"/><label asp-for="MaxMegabytes"></label><input asp-for="MaxMegabytes" class="form-control" min="1" max="50"/><p class="muted mt-3">กำหนดตามประกาศของคณะ จำนวนหน้าที่ตรวจนับรวมปก สารบัญ และหลักฐานทั้งหมด</p></section><button class="btn btn-primary w-100">บันทึกและจัดผลงานต่อ →</button></div></div></form>
