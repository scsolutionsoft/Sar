@model PortfolioEntryForm
@{ViewData["Title"]="เพิ่ม / แก้ไขผลงาน";var docs=(List<PersonalDocument>)ViewBag.Documents;}
<div class="page-head"><div><p class="eyebrow">TELL THE STORY BEHIND YOUR WORK</p><h1>เรื่องราวของผลงาน</h1><p class="muted">เลือกงานที่เกี่ยวข้อง อธิบายสิ่งที่คุณลงมือทำและได้เรียนรู้</p></div><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.PortfolioId">กลับแฟ้ม</a></div>
<form method="post" enctype="multipart/form-data" class="panel" id="entryForm"><input asp-for="Id" type="hidden"/><input asp-for="PortfolioId" type="hidden"/><input asp-for="PortfolioVersion" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label asp-for="Title"></label><input asp-for="Title" class="form-control" required/></div><div class="col-md-4"><label asp-for="Section"></label><select asp-for="Section" class="form-select">@foreach(var s in Enum.GetValues<PortfolioSection>()){<option value="@s">@PersonalInput.Section(s)</option>}</select></div><div class="col-md-4"><label asp-for="Date"></label><input asp-for="Date" type="date" class="form-control"/></div><div class="col-md-6"><label asp-for="Role"></label><input asp-for="Role" class="form-control"/></div><div class="col-md-2"><label asp-for="SortOrder"></label><input asp-for="SortOrder" class="form-control"/></div><div class="col-12"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="4" maxlength="1200"></textarea></div><div class="col-md-6"><label asp-for="Outcome"></label><textarea asp-for="Outcome" class="form-control" rows="4" maxlength="800"></textarea></div><div class="col-md-6"><label asp-for="Reflection"></label><textarea asp-for="Reflection" class="form-control" rows="4" maxlength="800"></textarea></div><div class="col-md-6"><label asp-for="Link"></label><input asp-for="Link" class="form-control" type="url"/></div><div class="col-md-6"><label asp-for="PersonalDocumentId"></label><select asp-for="PersonalDocumentId" class="form-select"><option value="">ยังไม่แนบหลักฐาน</option>@foreach(var d in docs){<option value="@d.Id">@d.Title (@d.Pages หน้า)</option>}</select></div><div class="col-12"><label>ภาพประกอบผลงาน (JPG, PNG, WebP)</label><input asp-for="ImageUpload" class="form-control" type="file" accept="image/jpeg,image/png,image/webp"/>@if(Model.CurrentImageId.HasValue){<img class="folio-current-photo" src="/files/@Model.CurrentImageId" alt="ภาพผลงาน"/><label><input asp-for="RemoveImage"/> ลบภาพเดิม</label>}</div></div><button class="btn btn-primary mt-4">บันทึกผลงาน</button></form>
