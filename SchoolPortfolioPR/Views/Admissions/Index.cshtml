@model List<AdmissionPortfolio>
@{ViewData["Title"]="แฟ้มสะสมผลงานยื่นเรียนต่อ";}
<partial name="_HelpBanner"/>
<div class="folio-welcome"><div><p class="eyebrow">YOUR STORY. YOUR NEXT CHAPTER.</p><h1>เล่าเรื่องตัวคุณ<br/><span>ผ่านผลงานที่ภาคภูมิใจ</span></h1><p>จัดประวัติ ทักษะ และผลงานเป็นแฟ้มอินโฟกราฟิก<br/>เปิดอ่านแบบพลิกหน้า และส่งออก PDF พร้อมหลักฐานประกอบ</p><a class="btn btn-primary" asp-action="Edit">+ สร้างแฟ้มสะสมผลงาน</a></div><div class="folio-welcome-art" aria-hidden="true"><span>PORT<br/>FOLIO.</span><small>LEARN · CREATE · GROW</small></div></div>
<div class="section-head"><h2>แฟ้มของฉัน</h2><a asp-controller="Documents" asp-action="Index">คลัง PDF ส่วนตัว →</a></div><div class="personal-doc-grid">@foreach(var p in Model){<article class="panel folio-card theme-@p.Theme.ToString().ToLowerInvariant()" data-portfolio-id="@p.Id"><div class="folio-mini-cover"><span>PORTFOLIO</span><strong>@p.FullName</strong><small>@p.TargetFaculty</small></div><h2>@p.Title</h2><p class="muted">@p.TargetUniversity</p><p class="count-chip">@(p.PdfFileId.HasValue?$"PDF {p.ExportedPages} หน้า":"กำลังจัดเตรียม")</p><div class="d-flex gap-2"><a class="btn btn-primary" asp-action="Details" asp-route-id="@p.Id">จัดแฟ้ม</a>@if(p.PdfFileId.HasValue){<a class="btn btn-light" asp-action="Viewer" asp-route-id="@p.Id">เปิดอ่าน</a>}</div></article>}</div>
@if(Model.Count==0){<div class="panel empty">เริ่มจากประวัติและเป้าหมาย แล้วเพิ่มผลงานที่สะท้อนความสามารถของคุณ</div>}
