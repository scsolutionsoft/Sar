@model AdmissionPortfolio
@{ViewData["Title"]=Model.Title;}
<div class="page-head"><div><p class="eyebrow">PERSONAL PORTFOLIO · @Model.ExportedPages PAGES</p><h1>@Model.Title</h1><p class="muted">แฟ้มส่วนตัวของ @Model.FullName · ดาวน์โหลด PDF เพื่อนำไปยื่น</p></div><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">กลับไปจัดแฟ้ม</a></div>
@if(Model.PdfFileId==null){<div class="panel empty">ยังไม่มี PDF ฉบับล่าสุด กรุณาสร้าง PDF จากหน้าจัดแฟ้ม</div>}else{<div id="flipbook" data-pdf="/files/@Model.PdfFileId" class="panel"><div class="viewer-toolbar"><button id="previous" class="btn btn-light">← ก่อนหน้า</button><button id="next" class="btn btn-light">ถัดไป →</button><label>หน้า <input id="pageNumber" type="number" min="1" value="1" class="form-control d-inline"/> / <span id="pageCount">…</span></label><button id="zoomOut" class="btn btn-light" aria-label="ย่อ">−</button><button id="zoomIn" class="btn btn-light" aria-label="ขยาย">+</button><button id="fullscreen" class="btn btn-light">เต็มจอ</button><a class="btn btn-outline-primary" href="/files/@Model.PdfFileId" data-media-preview data-media-type="pdf" data-media-title="@Model.Title">ดู PDF</a><a class="btn btn-primary" href="/files/@Model.PdfFileId?download=true">ดาวน์โหลด PDF</a></div><div class="row"><div class="col-md-3"><h2>สารบัญ</h2><select id="toc" class="form-select" size="10" aria-label="สารบัญ"></select><p class="muted mt-3">ใช้ปุ่มลูกศร หรือปัดซ้าย–ขวาบนมือถือเพื่อพลิกหน้า</p></div><div class="col-md-9"><div class="flip-stage"><canvas id="pdfCanvas" aria-label="หน้าแฟ้มสะสมผลงาน"></canvas></div></div></div><p id="viewerStatus" role="status"></p></div>}
@section Scripts{<script type="module" src="~/js/flipbook.js" asp-append-version="true"></script>}
