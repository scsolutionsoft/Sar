@model PageView<NamedRecord>
@{ViewBag.Page = Model.Page; ViewBag.Pages = Model.Pages;}
<div class="page-head"><h1>@ViewBag.Title</h1><a class="btn btn-primary" asp-action="Edit" asp-route-kind="@ViewBag.Kind">+ เพิ่มข้อมูล</a></div><div class="panel"><form method="get" class="d-flex gap-2 mb-3"><input type="hidden" name="kind" value="@ViewBag.Kind"/><input name="q" value="@ViewBag.Search" placeholder="ค้นหาชื่อ" aria-label="ค้นหาชื่อ" class="form-control"/><button class="btn btn-outline-primary">ค้นหา</button></form><div class="table-responsive"><table class="table"><thead><tr><th>ชื่อ</th><th>จัดการ</th></tr></thead><tbody>@foreach(var r in Model.Items){<tr><td>@r.Name</td><td><a asp-action="Edit" asp-route-kind="@ViewBag.Kind" asp-route-id="@r.Id" class="btn btn-sm btn-light">แก้ไข</a> <form asp-action="Delete" method="post" class="d-inline" data-confirm><input type="hidden" name="kind" value="@ViewBag.Kind"/><input type="hidden" name="id" value="@r.Id"/><button class="btn btn-sm btn-outline-danger">ลบ</button></form></td></tr>}</tbody></table></div><partial name="_Pagination"/></div>
