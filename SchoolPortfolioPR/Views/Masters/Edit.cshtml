@model MasterForm
<h1>@ViewBag.Title</h1><form method="post" class="panel"><input asp-for="Id" type="hidden"/><input name="kind" type="hidden" value="@ViewBag.Kind"/><div asp-validation-summary="All"></div><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/>
@if(ViewBag.Kind is "Teacher" or "Student"){<label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control"/><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select"><option value="">ไม่ระบุ</option></select>}
@if(ViewBag.Kind == "Teacher"){<label asp-for="SubjectGroupId" class="form-label"></label><select asp-for="SubjectGroupId" asp-items="ViewBag.SubjectGroups" class="form-select"><option value="">ไม่ระบุ</option></select>}
@if(ViewBag.Kind == "Student"){<label asp-for="Classroom" class="form-label"></label><input asp-for="Classroom" class="form-control" placeholder="เช่น ม.6/1 หรือ ป.3/2" aria-describedby="classroomHint"/><small id="classroomHint" class="text-muted">ระบุระดับชั้น/ห้อง เช่น ม.6/1 เพื่อใช้กรองรายชื่อนักเรียนในกิจกรรมและรางวัล</small>}
@if(ViewBag.Kind == "AcademicYear"){<label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control"/><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control"/>}
@if(ViewBag.Kind == "SchoolProfile"){<label asp-for="DirectorName" class="form-label"></label><input asp-for="DirectorName" class="form-control"/><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control"/><label asp-for="Contact" class="form-label"></label><input asp-for="Contact" class="form-control"/>}
<button class="btn btn-primary mt-4">บันทึก</button> <a asp-action="Index" asp-route-kind="@ViewBag.Kind" class="btn btn-light mt-4">กลับรายการ</a></form>
