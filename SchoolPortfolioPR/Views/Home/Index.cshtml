@model PageView<Activity>
@{ViewData["Title"] = "ข่าวและผลงานโรงเรียน"; ViewBag.Page = Model.Page; ViewBag.Pages = Model.Pages; var school = (SchoolProfile?)ViewBag.School;}
<section class="pr-intro"><div><p class="eyebrow">@(school?.Name ?? "SchoolPortfolioPR") · NEWSROOM</p><h1>พื้นที่แห่งการเรียนรู้<br/><em>ข่าวสารที่อยากบอกต่อ</em></h1><p class="muted mb-0">ติดตามประกาศสำคัญ กิจกรรม และเรื่องราวดี ๆ ของโรงเรียน<br/>เชื่อมทุกความเคลื่อนไหวไว้ในพื้นที่เดียว</p></div><div class="pr-intro-aside"><span class="pr-edition">ประชาสัมพันธ์โรงเรียน</span><a href="/Publications" class="btn btn-primary">เปิดอ่านวารสาร ↗</a><a href="#latest">ข่าวและกิจกรรมล่าสุด ↓</a></div></section>
@if(((List<Announcement>)ViewBag.Announcements).Count > 0){<section aria-labelledby="boardHeading"><div class="section-head"><div><p class="eyebrow">SPOTLIGHT & ANNOUNCEMENTS</p><h2 class="pr-section-title" id="boardHeading">กระดานประชาสัมพันธ์</h2></div><span class="count-chip">เรื่องเด่นวันนี้</span></div><partial name="_AnnouncementBoard" model="(List<Announcement>)ViewBag.Announcements"/></section>}
@if(((List<MonthlyPublication>)ViewBag.Publications).Count > 0){<section aria-labelledby="magazineHeading"><div class="section-head"><div><p class="eyebrow">THE SCHOOL EDITION</p><h2 class="pr-section-title" id="magazineHeading">วารสารจากรั้วโรงเรียน</h2></div><a href="/Publications">ทุกฉบับ →</a></div><div class="pr-magazine-strip">@foreach(MonthlyPublication p in ViewBag.Publications){<a class="pr-magazine" href="/publications/@(p.Year + 543)/@p.Month"><span class="pr-magazine-icon"><partial name="_Icon" model='"book"'/></span><div><small>ฉบับเดือน @p.Month / @(p.Year + 543)</small><h3>@p.Title</h3><p>เปิดอ่านวารสารออนไลน์ ↗</p></div></a>}</div></section>}
@if(((List<Activity>)ViewBag.Featured).Count > 0){<h2>กิจกรรมแนะนำ</h2><div class="row mb-4">@foreach(Activity a in ViewBag.Featured){<div class="col-md-4"><div class="card news-card">@if(a.CoverImageId.HasValue){<a class="media-trigger" href="/files/@a.CoverImageId" data-media-preview data-media-type="image" data-media-title="@a.Title" data-media-group="home-images"><img class="news-cover" src="/files/@a.CoverImageId" alt="@a.Title"/></a>}<a href="/news/@(a.ActivityDate.Year + 543)/@a.Slug"><h2>@a.Title</h2></a></div></div>}</div>}
<div class="page-head" id="latest"><div><p class="eyebrow">Latest stories</p><h2>ข่าวและกิจกรรมล่าสุด</h2></div><form method="get" class="d-flex gap-2"><input name="q" value="@ViewBag.Search" class="form-control" placeholder="ค้นหาข่าว" aria-label="ค้นหาข่าว"/><button class="btn btn-outline-primary">ค้นหา</button></form></div><div class="row g-4 mb-4">@foreach(var a in Model.Items){<div class="col-md-6 col-xl-4"><article class="card news-card">@if(a.CoverImageId.HasValue){<a class="media-trigger" href="/files/@a.CoverImageId" data-media-preview data-media-type="image" data-media-title="@a.Title" data-media-group="home-images"><img class="news-cover" src="/files/@a.CoverImageId" alt="@a.Title" loading="lazy"/></a>}else{<div class="cover-placeholder">▤</div>}<small>@Thai.Date(a.ActivityDate)</small><h2><a href="/news/@(a.ActivityDate.Year + 543)/@a.Slug">@a.Title</a></h2><p class="muted">@a.ShortDescription</p><a href="/activity/@a.Id" class="mt-auto">อ่านเรื่องราวและชมภาพ →</a></article></div>}</div>@if(Model.Total == 0){<div class="panel empty">ยังไม่มีข่าวเผยแพร่ ติดตามเรื่องราวใหม่ได้เร็ว ๆ นี้</div>}<partial name="_Pagination"/>
<div class="row mt-5"><div class="col-lg-7"><p class="eyebrow">Proud moments</p><h2>รางวัลแห่งความภาคภูมิใจ</h2><div class="panel">@foreach(Award a in ViewBag.Awards){<div class="border-bottom py-3"><a asp-controller="Awards" asp-action="Details" asp-route-id="@a.Id">☆ @a.AwardName</a><small class="d-block">@Thai.Level(a.AwardLevel) · @a.AwardRank · @Thai.Date(a.AwardDate)</small></div>}@if(((List<Award>)ViewBag.Awards).Count == 0){<p class="empty">ยังไม่มีรางวัลเผยแพร่</p>}</div></div><div class="col-lg-5"><p class="eyebrow">School magazine</p><h2>วารสารประจำเดือน</h2><div class="panel">@foreach(MonthlyPublication p in ViewBag.Publications){<div class="border-bottom py-3"><a asp-controller="Publications" asp-action="Viewer" asp-route-year="@(p.Year + 543)" asp-route-month="@p.Month">@p.Title →</a><small class="d-block">@p.Month / @(p.Year + 543)</small></div>}<a href="/Publications" class="btn btn-outline-primary mt-3">วารสารทั้งหมด</a></div></div></div>

